---
import { fmtDate, readingTime, url } from '../lib/utils';
interface Props { href: string; title: string; summary: string; date: Date; body?: string; extra?: string; }
const { href, title, summary, date, body, extra } = Astro.props;
---
<a class="row" href={url(href)}>
  <div class="card-top">
    <h3>{title}</h3>
    <span class="meta">
      {extra && <span>{extra}</span>}
      <time datetime={date.toISOString()}>{fmtDate(date)}</time>
      <span>{readingTime(body)}</span>
    </span>
  </div>
  <p>{summary}</p>
</a>
