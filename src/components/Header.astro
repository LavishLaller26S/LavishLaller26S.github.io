---
import { site } from '../site.config';
import { url } from '../lib/utils';
const nav = Object.values(site.sections).filter((s) => s.enabled);
const current = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
---
<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href={url('/')}>{site.shortName}<span class="dot">.</span></a>
    <nav aria-label="Main">
      {nav.map((s) => (
        <a href={url(s.path)} aria-current={current.startsWith(s.path) ? 'page' : undefined}>{s.title}</a>
      ))}
      <a href={url('/rss.xml')}>RSS</a>
      <a class="btn primary hire" href={url('/about#contact')}>Hire me</a>
    </nav>
  </div>
</header>

<style>
  .site-header { border-bottom: 1px solid var(--border); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 1rem 2rem; padding-block: 1.25rem; flex-wrap: wrap; }
  .brand { font-weight: 700; font-size: 1.1rem; color: var(--text); text-decoration: none; letter-spacing: -0.01em; }
  .dot { color: var(--green-text); }
  nav { display: flex; align-items: center; gap: 0.35rem 1.4rem; flex-wrap: wrap; }
  nav a:not(.btn) { color: var(--muted); text-decoration: none; font-size: 0.98rem; }
  nav a:not(.btn):hover, nav a[aria-current='page'] { color: var(--text); }
  nav a[aria-current='page'] { box-shadow: inset 0 -2px 0 var(--green); }
  .hire { padding: 0.55rem 0.9rem; }
</style>
