---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import Empty from '../../components/Empty.astro';
import { site } from '../../site.config';
import { published, url } from '../../lib/utils';
const sec = site.sections.work;
if (!sec.enabled) return Astro.redirect(url('/'));
const projects = (await published('projects')).sort((a, b) => Number(b.data.featured) - Number(a.data.featured));
---
<Base title={sec.title} description={sec.blurb}>
  <header class="page-head"><h1>{sec.title}</h1><p>{sec.blurb}</p></header>
  {projects.length ? projects.map((p) => <ProjectCard project={p} />) : <Empty text="Projects are on the way." />}
</Base>
