---
import { render } from 'astro:content';
import Post from '../../layouts/Post.astro';
import { site } from '../../site.config';
import { published } from '../../lib/utils';

export async function getStaticPaths() {
  if (!site.sections.work.enabled) return [];
  return (await published('projects')).map((p) => ({ params: { id: p.id }, props: { p } }));
}
const { p } = Astro.props;
const { Content } = await render(p);
const d = p.data;
---
<Post title={d.title} summary={d.summary} date={d.date} body={p.body} tags={d.stack} back={{ href: site.sections.work.path, label: site.sections.work.title }}>
  <div slot="head-extra" class="links">
    <span class:list={['status', d.status]}>{d.status}</span>
    {d.repo && <a class="btn" href={d.repo}>Source code</a>}
    {d.demo && <a class="btn primary" href={d.demo}>Live demo</a>}
  </div>
  <Content />
</Post>
<style>.links { display: flex; align-items: center; gap: .6rem; flex-wrap: wrap; margin-top: 1rem; }</style>
